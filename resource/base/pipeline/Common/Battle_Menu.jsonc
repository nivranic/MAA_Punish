{
    "打开战斗": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "主界面_战斗节点"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    60,
                    0,
                    -60,
                    0
                ]
            }
        },
        "post_wait_freezes": {
            "time": 500,
            "timeout": 5000
        }
    },
    "意外点击_限定活动": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "意外点击_限定活动_文字",
                    "意外点击_活动总览"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    78,
                    36
                ]
            }
        },
        "post_delay": 3000
    },
    "意外点击_活动总览": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "返回",
                    "返回主菜单_reco",
                    "活动总览_跳过动画文字"
                ]
            }
        }
    },
    "活动总览_跳过动画文字": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1040,
                    0,
                    200,
                    65
                ],
                "expected": "跳过动画"
            }
        }
    },
    "意外点击_限定活动_文字": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    66,
                    210,
                    142
                ],
                "expected": "限定开放"
            }
        }
    }
}
