{
    "兑换码": {
        "attach": {"daily_progress_guard_node": "日常断点_兑换码"},
        "next": ["日常账本准入"],
        "on_error": []
    },
    "日常断点_兑换码": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "DailyProgressCheck"
            }
        },
        "attach": {
            "daily_progress_key": "兑换码"
        },
        "next": [
            // 只有无历史记录且无未确认提交的码才会进入兑换流程。
            // 无可提交项的空任务结束不等于游戏兑换成功。
            "[JumpBack]检查是否需要运行",
            "空任务"
        ]
    },
    "检查是否需要运行": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "CheckRedeemCode"
            }
        },
        "next": [
            "[JumpBack]可以输入兑换码",
            "[JumpBack]打开个人页面",
            "[JumpBack]关闭奖励",
            "[JumpBack]返回主菜单"
        ]
    },
    "打开个人页面": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    0,
                    236,
                    217
                ],
                "expected": [
                    "等级",
                    "勋阶",
                    "[iI][dD]\\s*[：:]\\s*\\d+"
                ]
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "可以输入兑换码": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    752,
                    468,
                    528,
                    252
                ],
                "expected": "请输入兑换码"
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RedeemCode",
                "custom_action_param": {
                    //兑换码放在这里
                    "code": [
                        "PUNISHING0924"
                    ]
                }
            }
        },
        "on_error": []
    },
    "确认兑换": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1058,
                    395,
                    222,
                    325
                ],
                "expected": "^兑换$"
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "点击兑换码": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    752,
                    468,
                    528,
                    252
                ],
                "expected": "请输入兑换码"
            }
        },
        "action": {
            "type": "Click"
        }
    }
}
