        // 入场对话自动播放超 5 分钟（点字幕可推进），加上战斗本身耗时，300s 必超时。
        // seg103 实证：「不期而遇」多步事件（按钮×4+对话×N）在 BOSS 轮询内消耗
        // 超 900s（15 分钟）——拉到 1800s 给全事件链余量。
        "timeout": 1800000,
        "rate_limit": 0,
        "next": [
            "矩阵循生_套装调整",
            "不祥烙印_矩阵循生",
            "厄运连锁_矩阵循生",
            "矩阵循生_模拟演算完成",
            "战斗完成_矩阵循生",
            "战斗失败",
            "[JumpBack]矩阵循生_算力不足放弃",
            "[JumpBack]放弃战斗_矩阵循生",
            "[JumpBack]算力单元不足",
            "[JumpBack]深渊余音_矩阵循生",
            "[JumpBack]深渊余音_选择",
            "[JumpBack]深渊余音_前往",
            // seg95 实拍：「不期而遇」事件页（继续前进按钮 y612）落在战斗对话推进
            // 的字幕 ROI 内被空 expected 命中→点字幕落空循环 16 分钟。按钮节点插在
            // 对话推进之前，BOSS 轮询里按钮页优先点按钮。
            "[JumpBack]不期而遇_继续前进",
            // seg100 实拍：BOSS.png 在「不期而遇」尝试触摸页（红色调+机械元素）误
            // 命中→BOSS 轮询 900s 内无按钮节点可点空转杀局，尝试触摸同位补挂。
            "[JumpBack]不期而遇_尝试触摸",
            // seg101 实拍：不期而遇第三步=选项条「开枪」+决定（事件选项页同型），
            // BOSS 轮询内补事件选项承接（选中选项→决定推进）。
            "[JumpBack]矩阵循生_事件选项",
            // seg112 实拍：决定后进入 BOSS 战预备向导「选择效应」页（点队伍调整
            // tab 推进）。
            "[JumpBack]选择效应_矩阵循生",
            // seg148 实锤（f201）：残象落语叙事链点完落「藏品」检视页，泛按钮空
            // expected 在详情面板文字上持续命中→死循环。意外点击藏品（Or 藏品/物品
            // 详情标题，非 JumpBack 走其自身 关闭详情/返回 退出链）先于泛按钮接住。
            "意外点击藏品_矩阵循生",
            // seg149 实锤（f121）：棋盘上残象落语事件卡确认页（确定按钮）是叙事链
            // 入口，先接住再进叙事；seg152 起通用 棋盘卡确定 覆盖任意卡名（藏品锚）。
            "[JumpBack]矩阵循生_棋盘卡确定",
            "[JumpBack]矩阵循生_残象卡确定",
            // seg150 实锤（f233/f313 同帧 9 分钟）：事件链完成后的「幽密深潭
            // Chapter.IV」章节转场卡静止等待交互，BOSS战 next 无 转场 接住→
            // 1800s 超时弃局。转场_矩阵循生（OCR Chapter，点顶部跳过）补挂。
            "[JumpBack]转场_矩阵循生",
            // seg146/147 实锤：BOSS 败亡后残象落语叙事页右下按钮每页换文案（收起武器→
            // 观察门扉→…），是唯一推进点；对话推进字幕 ROI 会罩住该页叙事字幕空转
            // 57/108 分钟——泛按钮先于对话推进。
            // 战中对白可被战斗层识别后交回这里；精确跳过优先于泛按钮及字幕，保留前面的事件处理。
            "[JumpBack]跳过战斗对话",
            "[JumpBack]矩阵循生_叙事右下按钮",
            "[JumpBack]矩阵循生_战斗对话推进",
            "[JumpBack]矩阵循生_战斗就绪",
            "[JumpBack]出击_矩阵循生",
            "[JumpBack]进入战斗_矩阵循生",
            "[JumpBack]碧碧通信_矩阵循生"
        ]
