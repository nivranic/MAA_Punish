{
    "矩阵循生_战斗就绪": {
        "recognition": {
            "type": "And",
            "param": {"all_of": ["战斗中", "矩阵循生_闪避操作图标"]}
        },
        "action": {"type": "DoNothing"},
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        // seg114 实锤（seg114-death2-raw.txt + 意识重启请求实拍）：战斗入场瞬间
        // 游戏可弹「意识重启请求」付费恢复弹窗（0/9240 未初始化 HP 条+放弃/重启），
        // 战斗事件→出击→载入中→战斗就绪 直连链绕过主轮询，弹窗节点（仅挂主轮询）
        // 无机会执行——R03CombatRunner 透过弹窗读战场身份字段=unknown，守卫
        // fail-closed 拒战（r3_strategy_identity_mismatch，loop_count=0）杀局。
        // next 首位补挂弹窗：命中→点放弃→JumpBack 重入本列表→弹窗已撤，干净进 runner。
        "next": ["[JumpBack]矩阵循生_算力不足放弃", "[JumpBack]矩阵循生_意识重启弹窗", "战斗中"]
    },
    "矩阵循生_闪避操作图标": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [1000, 420, 250, 300],
                "template": "战斗/闪避.png",
                "green_mask": true,
                "threshold": 0.6
            }
        }
    },
    "矩阵循生_战斗兜底": {
        "recognition": {
            "type": "OCR",
            "param": {
                // seg80 实证：圣殿战役类带 TIME 计时器的战斗变体 HUD 占住战斗中模板
                // 位（[1077,49] TIME），战斗就绪 And 全 miss→第三场战斗无 CombatRunner
                // 接管→主轮询 4 分钟全 miss→优雅退出杀局。以战斗 HUD 左上血量分数
                // （5770/9948 实测 box[73,23]）为锚直连 CombatRunner；意识重启弹窗
                // 0/9240 也命中此锚，故本条目必须挂在 意识重启弹窗 之后。
                "roi": [60, 10, 210, 40],
                "expected": ["^\\d+/\\d+$"]
            }
        },
        "action": {"type": "DoNothing"},
        "timeout": 10000,
        "next": ["矩阵循生_战斗兜底_接管"]
    },
    "矩阵循生_战斗兜底_接管": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {
            "type": "Custom",
            "param": {"custom_action": "CombatRunner"}
        },
        "post_delay": 0,
        "rate_limit": 0
    },
    "矩阵循生_场外终焉头像": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [1125, 110, 100, 100],
