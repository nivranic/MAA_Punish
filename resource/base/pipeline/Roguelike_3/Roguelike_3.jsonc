    "矩阵循生_完成结算统计": {
        "recognition": {
            "type": "And",
            "param": {"all_of": ["矩阵循生_完成统计标题", "矩阵循生_完成统计按钮"], "box_index": 1}
        },
        "action": {"type": "Click"},
        // 2026-11-19 seg126 实证（00:40-00:41 结算流）：数据统计页点完成后仍有多页
        // 下一页结算卡才到启程页；旧 next=[完成结算停止] 只等 启程锚 20s——页未翻完
        // 即超时，主列表 下一页/启程_矩阵循生 抢点开新局，StopTask 自然结算被错过。
        // 修复：先 JumpBack 翻完结算余页再交停止节点，timeout 120s 覆盖全程。
        "timeout": 120000,
        "next": ["[JumpBack]矩阵循生_完成结算下一页", "矩阵循生_完成结算停止"]
    },
