    "矩阵循生_完成结算分派": {
        "recognition": {"type": "DirectHit"},
        // 2026-11-19 seg126 实测：整条结算流（横幅→继续→3×下一页→统计→完成→余页→
        // 启程）约 40s，60s 预算过紧，放宽到 120s 覆盖翻页迟滞。
        "timeout": 120000,
        "next": [
