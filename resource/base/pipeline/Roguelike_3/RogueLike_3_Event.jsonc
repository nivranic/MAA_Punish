        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    700,
                    96,
                    254,
                    62
                ],
                "expected": ""
            }
        },
        // The focus event and native OCR detail already report the unknown title.
        // 才能假象/歧路异途 事件页出现时轮询可能走本链（肉鸽内部 next 未及重扫），
        // 故在本链头部再给一次已知事件机会，未命中才走返回/退出。
        // 2026-11-16 seg31：默认 20s 列表超时会在才能假象对话框翻页动画（按钮未渲染
        // 间隙）耗尽，NextList 整链失败走优雅退出；放宽到 120s 让对话推进完。
        "action": {"type": "DoNothing"},
        "timeout": 120000,
        // seg191：通信事件完成画面误入本链（事件确定误命中选择界面确定钮→next 轮到
        // 本兜底）时 120s 超时走 Default.on_error 杀任务——但主调度有事件完成继续/
        // 事件卡_用尽 等全部新锚可自愈。改吞错：超时后回主调度重新轮询。
        "on_error": ["矩阵循生_错误吞没"],
        "post_delay": 1000,
        "next": [
            "链路崩溃_reco",
            "[JumpBack]才能假象_选择",
            "[JumpBack]才能假象_矩阵循生",
            // seg155 实锤（f072/f080 同页）：「骇客挑战」事件页（右上任意标题+
            // 叙事文+右下唯一 4 字按钮「接受挑战」）命中本兜底链后旧 next 无按钮
            // 可点→120s 超时误杀。叙事右下按钮（4+ 汉字正则，收起武器/观察门扉/
            // 制备完成/接受挑战 同族）插在返回/退出之前。
            "[JumpBack]矩阵循生_叙事右下按钮",
            // seg156 实锤（f120）：骇客挑战战斗完成后的选项页（休整状态/直接离开+
            // 右下决定）——事件选项（And 决定锚+选项区文本，通用）补挂承接。
            "[JumpBack]矩阵循生_事件选项",
            // seg157 实锤（f050）：骇客挑战收尾后「陆离迷宫 Chapter.III」章节转场卡
            // 静止等交互——转场_矩阵循生 此前只在 BOSS战 next，本链与主轮询均无。
            "[JumpBack]转场_矩阵循生",
            "[JumpBack]矩阵循生_领取奖励页",
            "[JumpBack]歧路异途_矩阵循生",
            "[JumpBack]返回_矩阵循生",
            "[JumpBack]确认结束购物_矩阵循生",
            "矩阵循生_保留未完演算退出"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$focus.未知事件_矩阵循生"
        }
    },
