        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [950, 600, 260, 80],
                // 同位推进按钮随剧情阶段变化（2026-11-16 实测）：继续→决定→离开。
                "expected": ["^继续$", "^繼續$", "^决定$", "^決定$", "^离开$", "^離開$"]
            }
        }
    },
    // 2026-11-16 seg33/34 实拍：决定页必须先点选项再点决定（toast「请先选择选项！」），
    // 且本事件有多个选择页、每页选项文本不同（花钱向对方买诗/卖诗给对方赚钱 →
    // 破旧的速递包裹 → …），无法枚举。选项区 [650,340,560,180] 与叙事区不重叠，
    // 用空 expected 命中任意选项文本；纯对话页该区空白不命中，交给推进按钮。
    "才能假象_选项": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [650, 340, 560, 180],
                "expected": ""
            }
        }
    },
    "才能假象_选择": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": ["才能假象_标题", "才能假象_选项"],
                "box_index": 1
            }
        },
        "action": {"type": "Click"},
        "post_delay": 800,
        // 点击选项后进入下一段剧情，页面切换数秒无按钮可识别；无界 next 的失败会
        // 冒泡 default 终止任务（seg35 实证），JumpBack+timeout 让间隙内安全等待。
        "timeout": 120000,
        "next": ["[JumpBack]才能假象_矩阵循生"]
    },
    // 2026-11-16 seg36 实拍：才能假象事件结算发放「领取奖励」页（标题@565,45 顶部、
    // 三张 Reward 卡、底部套装/藏品计数），与既有 关闭奖励_矩阵循生 识别的「获得奖励」
    // @中部 文本位置双不同。seg38 实证：点返回会弹「是否暂停演算」→确认暂停→继续演算
    // →奖励未领取再次弹出，死循环。seg39 实拍：点卡片本体只是「选中」（四角白框标记，
    // 4 分钟无进展），真正领取须点卡片下方圆形「领取」按钮（中心~640,497）——两步链：
    // 先点中间卡选中，再点「领取」按钮；领完页面关闭回地图后确认节点超时，JumpBack
    // 返回上层列表由地图节点接管。
    "矩阵循生_领取奖励页": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [500, 30, 300, 60],
                "expected": ["^领取奖励$", "^領取獎勵$"]
            }
        },
        // seg93-now 实拍（00:30）：双卡变体（进阶型手提电视+散装单元(小)），卡各占
        // 左半与中部，点 [640,330] 落在两卡间隙=无选中→确认节点 60s 全 miss 杀局。
        // seg106-f003 实拍：三卡装备套装变体（惯性箭矢A/惯性护甲U/黎明行者），
        // 卡1 x220-435——[183,340] 落卡外间隙。取 [270,340]：双卡卡1(x130-300)与
        // 三卡卡1(x220-435) 均覆盖（点卡仅选中语义不变，seg39 定型）。
        "action": {"type": "Click", "param": {"target": [270, 340]}},
        "post_delay": 800,
        "timeout": 60000,
        // seg122 实锤（21:58:40-21:59:36）：TIME 变体战斗奖励页有标题但「领取」
        // 按钮 60s 不出现（材料耗尽态/未知变体）——本节点 next 原只有 确认 一项，
        // seg109 的 [JumpBack]返回 兜底挂在 确认 的 next 里，确认永不命中就永远
        // 轮不到→60s 超时炸节点。次位补 返回：有按钮时 确认 按序先中照领；
        // 无按钮 1-2s 内离开，取消暂停弹窗后主轮询可再次进入本页自愈。
        // 2026-11-19 seg130 实锤（f472/f479/f486 04:04-04:11 全程帧）：已领取所有
        // 奖励 空页上 返回 兜底形成自闭环（JumpBack 重入 4s/圈）且此页点返回弹
        // 「是否暂停演算」弹窗（seg38 同款），任务卡死。次位再插 事件尾声离开
        // （OCR 离开@[900,600,300,80] 恰为本页右下按钮）：领完经 离开 正常退出。
        // 2026-11-19 seg131 实锤（f117 04:28:27）：6 次复活死战后奖励页 离开 落在
        // 矩阵循生主枢纽页（DERIVED from Matrix，右下 继续/终止，run 存活）——本
        // 列表无继续节点→60s 失败优雅退出弃健康局。离开后再插 继续演算
        // （And:未完标记+继续钮）：落枢纽自动续跑，落地图不命中落返回兜底。
        // 2026-11-19 seg135 实锤（f512 07:04 枢纽页）：MaaFw next 每轮全序评估，
        // 继续演算 与 返回 相邻→继续点击后页面转换期 返回 仍可见→同轮双击弹回
        // 枢纽，7s/圈乒乓（继续演算+返回 同秒成对）。删除 返回 兜底（seg122
        // TIME 变体已由 离开/继续演算 覆盖，乒乓剧毒大于兜底收益）。
        // 2026-11-19 seg140 实锤（f265）：Ch.5 奖励页 离开 落 阶段12 三卡战斗选择
        // 页——列表无三卡节点 60s 失败弃 **已抵达 Ch.5 的健康局**。补挂三卡节点。
        // 2026-11-19 seg144 结构性兜底（f068 离开后落商店事件页）：离开后可落任意
        // in-run 页，逐个枚举不可穷尽——on_error 吞错交主调度大列表承接（商店/
        // 三卡/区域选择等全在主列表），未知页从任务死降级为一次调度循环。
        "on_error": ["矩阵循生_错误吞没"],
        "next": ["矩阵循生_领取奖励_确认", "[JumpBack]矩阵循生_事件尾声离开",
                 "[JumpBack]矩阵循生_继续演算", "[JumpBack]矩阵循生_终局战卡三卡"]
    },
    "矩阵循生_领取奖励_确认": {
        "recognition": {
            "type": "OCR",
            "param": {
                // seg93-now 实拍：双卡布局「领取」按钮 @[183,532]/[450,532]，旧单卡
                // ROI [560,450,160,95] 两按钮均不含。加宽到覆盖左半两卡按钮区。
                "roi": [100, 480, 560, 110],
                "expected": ["^领取$", "^領取$"]
            }
        },
        "action": {"type": "Click"},
        "post_delay": 1200,
        // seg107 实证：三卡全领完后页面自动关闭（回地图/事件页），旧 next 只有
        // 物品详情/领取奖励页两项→60s 全 miss 冒泡优雅退出。补尾页承接+20s 快速
        // 失败交主轮询大列表（主列表有 区域选择/事件尾声离开/转场 等全量锚）。
        "timeout": 20000,
        "next": [
            // seg198 实锤（08:55:02 on_error 帧）：BOSS 战胜利领完奖励页面自动落
            // 「请选择装备」页（三卡套装变体），旧 next 无装备页锚 20s 全 miss 超时，
            // 错误吞没回主轮询后又遭 肉鸽内部 OCR 藏品 噪声误命中级联炸局。
            "[JumpBack]选择装备_矩阵循生",
            "[JumpBack]矩阵循生_物品详情",
            "[JumpBack]矩阵循生_领取奖励页",
