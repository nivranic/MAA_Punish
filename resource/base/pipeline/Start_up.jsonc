        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "主界面_战斗节点"
                ]
            }
        },
        "next": [
            "切换主界面状态",
            "空任务"
        ]
    },
    "打开应用": {
        "max_hit": 1,
        "action": {
            "type": "StartApp",
            "param": {
                "package": "com.kurogame.haru.hero/com.haru.herousdk.SplashActivity"
            }
        },
        "post_delay": 5000,
        "on_error": [
            "服务器错误提示"
        ]
    },
    "计数器": {
        "max_hit": 60,
        "post_delay": 5000
    },
    "重启任务": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ResetCount",
                "custom_action_param": {
                    "nodes": [
                        "打开应用",
                        "计数器"
                    ]
                }
            }
        },
        "next": [
            "停止"
        ]
    },
    "服务器错误提示": {
        "next": [
            "启动"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "$focus.服务器错误提示"
        }
    },
    "切换主界面状态": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": ["主界面_战斗节点", "切换主界面状态_按钮"],
                "box_index": 1
            }
        },
        "action": {"type": "Click"}
    },
    "切换主界面状态_按钮": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1090,
                    460,
                    170,
                    100
                ],
                "template": [
                    "启动/切换主界面状态_默认.png",
                    "启动/切换主界面状态_家园.png",
                    "启动/切换主界面状态_恋屿干年歌.png",
                    "启动/切换主界面状态_白梦游弋.png",
                    "启动/切换主界面状态_离诗遗城.png",
                    "启动/切换主界面状态_耀阳映画.png",
                    "启动/切换主界面状态_花溪憩乡.png",
                    "启动/切换主界面状态_银光教堂.png",
                    "启动/切换主界面状态_闲庭疏影.png",
                    "启动/切换主界面状态_鸣神叹妙.png",
                    "启动/切换主界面状态_溺梦游歌.png"
                ]
            }
        }
    },
    "空任务": {
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "停止任务": {
        "action": {
            "type": "StopTask"
        }
    },
    "MAS联动处理-检查到维护公告_将发送假通知": {
        "enabled": false,
        // AUTO-MAS 靠这个字段识别停服维护并跳过本次运行（不计失败、不重试），请勿删除
        "attach": {
            "auto_mas": "server_maintenance"
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    482,
                    69,
                    316,
                    113
                ],
                "expected": [
                    "维护公告",
                    "服务器维护中.*"
                ]
            }
        },
        "focus": {
            "Node.Action.Succeeded": "战双维护中"
        }
    }
