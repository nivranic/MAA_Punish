{
    "关闭奖励": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "关闭奖励_颜色",
                    "关闭奖励_文字"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    446,
                    30
                ]
            }
        },
        "post_wait_freezes": {
            "time": 500,
            "timeout": 2000
        }
    },
    "确定": {
        "recognition": {
            "type": "And",
            "param": {
