    },
    "每日活跃宝箱100已领": {
        "recognition": {
            "type": "ColorMatch",
            "param": {"roi": [1129, 613, 50, 50], "method": 40,
                "lower": [55, 110, 100], "upper": [95, 255, 255], "count": 200}
        }
    },
    "领取活跃0-19": {
        "timeout": 3000,
        "on_error": [
            "任务失败优雅退出"
