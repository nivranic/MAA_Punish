{
    "任务": {
        "attach": {"daily_progress_guard_node": "日常断点_领取任务"},
        "next": ["日常账本准入"],
        "on_error": []
    },
    "日常断点_领取任务": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "DailyProgressCheck"
            }
        },
        "attach": {
            "daily_progress_key": "领取任务"
        },
        "next": [
            "每日助理交流",
            "[JumpBack]返回主菜单",
            "[JumpBack]关闭奖励",
            "[JumpBack]关闭点击空白弹窗"
        ]
    },
    "日常完成_领取任务": {
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DailyProgressMark"
            }
        },
        "attach": {
            "daily_progress_key": "领取任务"
        },
        "next": [
            "返回主菜单"
        ]
    },
    "每日助理交流": {
        "max_hit": 1,
        "recognition": {
            "type": "And",
            "param": {"all_of": ["主界面_战斗节点"]}
        },
        "action": {"type": "Click", "param": {"target": [620, 150]}},
        "post_delay": 200,
        "timeout": 4000,
        "on_error": ["助理交流入口缺失_转任务", "任务失败优雅退出"],
        "next": ["每日助理交流_进入"]
    },
    "每日助理交流_入口文字": {
        "recognition": {"type": "OCR", "param": {
            "roi": [300, 200, 350, 160], "expected": "^交流$"
        }}
    },
    "每日助理交流_进入": {
        "recognition": {"type": "And", "param": {
            "all_of": ["主界面_战斗节点", "每日助理交流_入口文字"], "box_index": 1
        }},
        "action": {"type": "Click"},
        "post_delay": 1000,
        "timeout": 8000,
        "on_error": ["助理交流入口缺失_转任务", "任务失败优雅退出"],
        "next": ["每日助理交流_完成返回"]
    },
    "助理交流入口缺失_转任务": {
        "recognition": {"type": "And", "param": {"all_of": ["主界面_战斗节点"]}},
        "action": {"type": "DoNothing"},
        "post_delay": 300,
        "focus": {"Node.Recognition.Succeeded": "$focus.助理交流入口缺失_转任务"},
        "next": ["任务_领取"]
    },
    "每日助理交流_档案文字": {
        "recognition": {"type": "OCR", "param": {
            "roi": [790, 55, 400, 100], "expected": "基本信息"
        }}
    },
    "每日助理交流_完成返回": {
        "recognition": {"type": "And", "param": {
            "all_of": ["每日助理交流_档案文字", "返回"], "box_index": 1
        }},
        "action": {"type": "Click"},
        "post_delay": 1000,
        "next": ["任务_领取"]
    },
    "任务_领取": {
        "next": [
            "每周任务",
            "[JumpBack]打开任务",
            "[JumpBack]意外点击_主界面"
        ]
    },
    "逐浪拾光": {
        "max_hit": 1,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    33,
                    215,
                    342
                ],
                "expected": "逐浪拾光"
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 500,
            "target": [
                1019,
                153,
                143,
                120
            ]
        },
        "next": [
            "前往任务"
        ]
    },
    "前往任务": {
        "pre_wait_freezes": {
            "time": 500,
            "target": [
                1019,
                153,
                143,
                120
            ]
        },
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1083,
                    528,
                    197,
                    192
                ],
                "expected": [
                    "前往",
                    "任务"
                ]
            }
        },
        "post_wait_freezes": {
            "time": 500,
            "target": [
                448,
                170,
                448,
                111
            ]
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "[JumpBack]领取_逐浪拾光",
            "返回主菜单"
        ]
    },
    "领取_逐浪拾光": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    940,
                    122,
                    340,
                    483
                ],
                "expected": "^领取$"
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [
            "关闭奖励"
        ]
    },
    "每日任务": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    7,
                    124,
                    264,
                    406
                ],
                "expected": "每日"
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 1000,
        "next": [
            "一键领取_任务",
            "每日活跃宝箱全部已领",
            "每日活跃不足奖励已领",
            "领取活跃0-19",
            "领取活跃20-39",
            "领取活跃40-59",
            "领取活跃60-79",
            "领取活跃80-99",
            "领取活跃100",
            "[JumpBack]关闭奖励"
        ]
    },
    "每日活跃宝箱全部已领": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "每日任务", "领取活跃100", "每日活跃宝箱20已领",
                    "每日活跃宝箱40已领", "每日活跃宝箱60已领",
                    "每日活跃宝箱80已领", "每日活跃宝箱100已领"
                ]
            }
        },
        "next": ["日常完成_领取任务"]
    },
    "每日活跃不足奖励已领": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "领取活跃0-19",
                    "每日活跃20档已领",
                    "每日活跃40档已领",
                    "每日活跃60档已领",
                    "每日活跃80档已领"
                ]
            }
        },
        "next": ["每日活跃不足返回"]
    },
    "每日活跃20档已领": {
        "recognition": {"type": "And", "param": {
            "all_of": ["领取活跃20-39", "每日活跃宝箱20已领"]
        }}
    },
    "每日活跃40档已领": {
        "recognition": {"type": "And", "param": {
            "all_of": ["领取活跃40-59", "每日活跃宝箱40已领"]
        }}
    },
    "每日活跃60档已领": {
        "recognition": {"type": "And", "param": {
            "all_of": ["领取活跃60-79", "每日活跃宝箱60已领"]
        }}
    },
    "每日活跃80档已领": {
        "recognition": {"type": "And", "param": {
            "all_of": ["领取活跃80-99", "每日活跃宝箱80已领"]
        }}
    },
    "每日活跃不足返回": {
        "recognition": {
            "type": "And",
            "param": {"all_of": ["返回主菜单_文字"]}
        },
        "action": {"type": "Click"},
        "post_delay": 1000,
        "focus": {"Node.Action.Succeeded": "$focus.每日活跃不足"},
        "next": ["任务失败优雅退出"]
    },
    "每日活跃宝箱20已领": {
        "recognition": {
            "type": "ColorMatch",
            "param": {"roi": [596, 613, 50, 50], "method": 40,
                "lower": [55, 110, 100], "upper": [95, 255, 255], "count": 200}
        }
    },
    "每日活跃宝箱40已领": {
        "recognition": {
            "type": "ColorMatch",
            "param": {"roi": [729, 613, 50, 50], "method": 40,
                "lower": [55, 110, 100], "upper": [95, 255, 255], "count": 200}
        }
    },
    "每日活跃宝箱60已领": {
        "recognition": {
            "type": "ColorMatch",
            "param": {"roi": [862, 613, 50, 50], "method": 40,
                "lower": [55, 110, 100], "upper": [95, 255, 255], "count": 200}
        }
    },
    "每日活跃宝箱80已领": {
        "recognition": {
            "type": "ColorMatch",
            "param": {"roi": [995, 613, 50, 50], "method": 40,
                "lower": [55, 110, 100], "upper": [95, 255, 255], "count": 200}
