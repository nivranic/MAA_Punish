    "历战映射_成员整备作战接续": {
        // 战前旧地图也有「结算」。先以原清队识别确认已经进入编队，
        // 再接手战斗和结算，不在成员整备点击失效时提前点结算。
        "recognition": {
            "type": "And",
            "param": {"all_of": ["清除队伍"]}
        },
        "pre_delay": 0,
        "post_delay": 0,
