{
    "历战映射_异常收尾": {
        "timeout": 20000,
        "next": [
            "返回主菜单",
            "[JumpBack]战斗失败_历战",
            "[JumpBack]历战映射_异常结算",
            "[JumpBack]关闭奖励",
            "[JumpBack]历战映射_异常撤退",
            "[JumpBack]历战映射_异常暂停",
            "[JumpBack]历战映射_异常确定",
            "[JumpBack]返回"
        ],
        "on_error": [
            "任务失败优雅退出"
        ]
    },
    "历战映射_异常暂停": {
        "max_hit": 2,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": ["战斗中"]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500
    },
    "历战映射_异常撤退": {
        "max_hit": 2,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": ["历战映射_撤退文字", "历战映射_重新开始文字"]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 500
    },
    "历战映射_撤退文字": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [960, 640, 260, 80],
                "expected": "撤退"
            }
        }
    },
    "历战映射_重新开始文字": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [700, 640, 250, 80],
                "expected": "重新开始"
            }
        }
    },
    "历战映射_异常确定": {
        "max_hit": 2,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": ["确定"]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 1000
    },
    "历战映射_异常结算": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "结算"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 500,
            "timeout": 2000
        }
    },
    "历战映射": {
        "on_error": [
            "返回主菜单",
            "任务失败优雅退出"
        ],
        "timeout": 5000,
        "next": [
            "日常断点_历战映射",
            "空任务"
        ]
    },
    "日常断点_历战映射": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "DailyProgressCheck"
            }
        },
        "attach": {
            "daily_progress_key": "历战映射"
        },
        "timeout": 5000,
        "on_error": [
            "返回主菜单",
            "任务失败优雅退出"
        ],
        "next": [
            "活动未开启",
            "[JumpBack]覆盖布局菜单",
            "[JumpBack]成员整备",
            "识别历战分数",
            "[JumpBack]开始挑战",
            "[JumpBack]前往作战",
            "[JumpBack]打开历战映射",
            "[JumpBack]打开挑战",
            "[JumpBack]打开战斗",
            "[JumpBack]意外点击_限定活动",
            "[JumpBack]意外点击_环境情报",
            "[JumpBack]意外点击_物品详情",
            "[JumpBack]意外点击_历战分数",
            "[JumpBack]作战开始"
        ]
    },
    "日常完成_历战映射": {
